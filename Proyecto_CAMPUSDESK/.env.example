# ==============================================================================
# CAMPUSDESK - Variables de Entorno y Configuración de Despliegue
# TechNova Solutions
# ==============================================================================

# ------------------------------------------------------------------------------
# PUERTOS EXPUESTOS EN EL HOST (Puertos alternativos para evitar colisiones)
# ------------------------------------------------------------------------------
# PostgreSQL (Por defecto 5432, mapeado al host como 5436)
DB_PORT=5436

# Redis (Por defecto 6379, mapeado al host como 6385)
REDIS_HOST_PORT=6385

# Backend REST API Spring Boot (Por defecto 8080/8050, mapeado al host como 8056)
BACKEND_PORT=8056
BACKEND_INTERNAL_PORT=8056

# Frontend Nginx Web Server (Por defecto 80/5500, mapeado al host como 5506)
FRONTEND_PORT=5506

# ------------------------------------------------------------------------------
# CREDENCIALES Y CONFIGURACIÓN DE BASE DE DATOS (campusdesk-db)
# ------------------------------------------------------------------------------
POSTGRES_DB=sistema_gestion_usuarios
POSTGRES_USER=admin
POSTGRES_PASSWORD=CAMBIAR_ESTE_VALOR_POSTGRES_PASS

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE REDIS (campusdesk-redis / Upstash en la nube)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CAMBIAR_ESTE_VALOR_REDIS_PASS
SESSION_TTL_SECONDS=28800
REDIS_SSL=false

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DEL BACKEND SPRING BOOT (campusdesk-backend)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# Seguridad JWT (Algoritmo HMAC256 - Secreto de al menos 32 caracteres obligatorio)
JWT_SECRET=CAMBIAR_ESTE_VALOR_JWT_SECRET_MINIMO_32_CARACTERES_SEGURO!
JWT_ISSUER=CampusDesk_API
JWT_EXPIRATION_MS=86400000

# Orígenes permitidos CORS (separados por coma, soporta dominios de la nube como *.onrender.com o *.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5506,http://localhost:5500,https://*.onrender.com,https://*.vercel.app
